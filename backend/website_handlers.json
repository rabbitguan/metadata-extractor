{
  "websites": [
    {
      "name": "arXiv",
      "domains": ["arxiv.org"],
      "patterns": ["arxiv.org/abs/", "arxiv.org/pdf/", "arxiv:"],
      "resource_type": "数据论文",
      "domain_type": "数据论文元数据",
      "handler": "handle_arxiv"
    },
    {
      "name": "Kaggle",
      "domains": ["kaggle.com"],
      "patterns": ["kaggle.com/datasets/"],
      "resource_type": "数据集",
      "domain_type": "数据集元数据",
      "handler": "handle_kaggle"
    },
    {
      "name": "Zenodo",
      "domains": ["zenodo.org"],
      "patterns": ["zenodo.org/record/"],
      "resource_type": "数据集",
      "domain_type": "数据集元数据",
      "handler": "handle_zenodo"
    },
    {
      "name": "Figshare",
      "domains": ["figshare.com"],
      "patterns": ["figshare.com/articles/"],
      "resource_type": "数据集",
      "domain_type": "数据集元数据",
      "handler": "handle_figshare"
    },
    {
      "name": "GitHub",
      "domains": ["github.com"],
      "patterns": ["github.com"],
      "resource_type": "数据集",
      "domain_type": "数据集元数据",
      "handler": "handle_github"
    },
    {
      "name": "OpenML",
      "domains": ["openml.org"],
      "patterns": ["openml.org/d/"],
      "resource_type": "数据集",
      "domain_type": "数据集元数据",
      "handler": "handle_openml"
    }
  ]
}
